FROM alpine:3.19

# Install required tools: dcron, bash, psql, dig, curl, jq
RUN apk add --no-cache dcron bash postgresql15-client bind-tools curl jq

# Copy script and crontab file
COPY sync_dns.sh /usr/local/bin/sync_dns.sh
COPY crontab /etc/crontabs/root

# Set permissions
RUN chmod +x /usr/local/bin/sync_dns.sh && \
    chmod 0600 /etc/crontabs/root && \
    touch /var/log/cron.log

# Export environment variables and launch crond
CMD env > /etc/environment && crond -f -l 2
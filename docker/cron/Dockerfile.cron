FROM alpine:3.19

# Install required tools: bash, psql, dig, curl, jq
RUN apk add --no-cache bash postgresql15-client bind-tools curl jq

# Copy the DNS sync scripts
COPY docker/cron/sync_dns.sh /usr/local/bin/sync_dns.sh
COPY docker/cron/dns_sync_loop.sh /usr/local/bin/dns_sync_loop.sh

# Set permissions
RUN chmod +x /usr/local/bin/sync_dns.sh /usr/local/bin/dns_sync_loop.sh

# Run DNS sync every 10 minutes without a cron daemon
CMD ["/bin/sh", "/usr/local/bin/dns_sync_loop.sh"]